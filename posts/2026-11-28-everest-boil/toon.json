 "voiceId": "JjTirzdD7T3GMLkwdd3a",
 "category": "فيزياء",
 "topic": "On the summit of Everest water boils at only about 70 °C because the air pressure is about a third of sea level, so tea comes out weak and eggs do not cook properly; a pressure cooker raises the pressure so water boils at a higher temperature.",
 "sources": [
  "https://chem.libretexts.org/Bookshelves/Introductory_Chemistry/Introductory_Chemistry_(CK-12)/13%3A_States_of_Matter/13.09%3A_Boiling",
  "https://www.iflscience.com/this-is-why-you-cant-boil-an-egg-on-mount-everest-74028",
  "https://www.compoundchem.com/2016/03/22/boiling-point/",
  "https://engineeringtoolbox.com/boiling-points-water-altitude-d_1344.html"
 ],
 "lines": [
  {
   "say": "عَلَى قِمَّةِ إِيفِرِسْت يَغْلِي الْمَاءُ، لٰكِنَّ الْبَيْضَةَ لَا تَنْضَجُ جَيِّدًا!",
   "show": "على قمة إيفرست يغلي الماء، لكن البيضة لا تنضج جيداً!",
   "gap": 0.6
  },
  {
   "say": "عِنْدَ سَطْحِ الْبَحْرِ يَغْلِي الْمَاءُ عِنْدَ مِئَةِ دَرَجَةٍ مِئَوِيَّةٍ.",
   "show": "عند سطح البحر يغلي الماء عند 100 درجة مئوية.",
   "gap": 0.9
  },
  {
   "say": "أَمَّا عَلَى الْقِمَّةِ فَيَغْلِي عِنْدَ سَبْعِينَ دَرَجَةً تَقْرِيبًا!",
   "show": "أما على القمة فيغلي عند 70 درجة تقريباً!",
   "gap": 0.4
  },
  {
   "say": "لِأَنَّ ضَغْطَ الْهَوَاءِ هُنَاكَ نَحْوُ ثُلُثِ ضَغْطِهِ عِنْدَ الْبَحْرِ.",
   "show": "لأن ضغط الهواء هناك نحو ثلث ضغطه عند البحر.",
   "gap": 0.9
  },
  {
   "say": "يَضْغَطُ هَوَاءٌ أَقَلُّ عَلَى الْمَاءِ، فَتُفْلِتُ جُزَيْئَاتُهُ بِسُهُولَةٍ.",
   "show": "يضغط هواء أقل على الماء، فتفلت جزيئاته بسهولة.",
   "gap": 0.35
  },
  {
   "say": "لِذٰلِكَ يَخْرُجُ الشَّايُ ضَعِيفًا، وَلَا تَنْضَجُ الْبَيْضَةُ تَمَامًا.",
   "show": "لذلك يخرج الشاي ضعيفاً، ولا تنضج البيضة تماماً.",
   "gap": 0.4
  },
  {
   "say": "وَالْحَلُّ؟ قِدْرُ الضَّغْطِ، فِيهِ يَغْلِي الْمَاءُ عِنْدَ حَرَارَةٍ أَعْلَى!",
   "show": "والحل؟ قدر الضغط، فيه يغلي الماء عند حرارة أعلى!",
   "gap": 0.4
  },
  {
   "say": "إِذًا، الْغَلَيَانُ لَا يَعْنِي دَائِمًا مِئَةَ دَرَجَةٍ! وَتَابِعْنَا عَلَى كْرِيتِيفْيَا سَايِنْس!",
   "show": "إذاً، الغليان لا يعني دائماً 100 درجة! وتابعنا على كريتيفيا ساينس!",
   "gap": 0.5
  }
 ],
