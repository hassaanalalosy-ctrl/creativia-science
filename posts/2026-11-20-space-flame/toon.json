 "lines": [
  {
   "say": "فِي الْفَضَاءِ، لَهَبُ الشَّمْعَةِ لَا يَرْتَفِعُ… بَلْ يَصِيرُ كُرَةً زَرْقَاءَ!",
   "show": "في الفضاء، لهب الشمعة لا يرتفع… بل يصير كرة زرقاء!"
  },
  {
   "say": "عَلَى الْأَرْضِ، الْهَوَاءُ السَّاخِنُ أَخَفُّ فَيَصْعَدُ إِلَى الْأَعْلَى.",
   "show": "على الأرض، الهواء الساخن أخف فيصعد إلى الأعلى."
  },
  {
   "say": "فَيَصِيرُ اللَّهَبُ طَوِيلًا كَالدَّمْعَةِ، وَيَدْخُلُ هَوَاءٌ جَدِيدٌ مِنَ الْأَسْفَلِ.",
   "show": "فيصير اللهب طويلاً كالدمعة، ويدخل هواء جديد من الأسفل."
  },
  {
   "say": "لَكِنْ فِي الْفَضَاءِ، الْهَوَاءُ السَّاخِنُ لَا يَصْعَدُ.",
   "show": "لكن في الفضاء، الهواء الساخن لا يصعد.",
   "gap": 0.9
  },
  {
   "say": "فَيَأْتِي الْهَوَاءُ بِبُطْءٍ مِنْ كُلِّ اتِّجَاهٍ… وَيَصِيرُ اللَّهَبُ كُرَةً زَرْقَاءَ خَافِتَةً!",
   "show": "فيأتي الهواء ببطء من كل اتجاه… ويصير اللهب كرة زرقاء خافتة!"
  },
  {
   "say": "إِذًا، شَكْلُ النَّارِ يَحْتَاجُ إِلَى الْجَاذِبِيَّةِ… وَتَابِعْنَا عَلَى كْرِيتِيفْيَا سَايِنْس!",
   "show": "إذاً، شكل النار يحتاج إلى الجاذبية… وتابعنا على كريتيفيا ساينس!",
   "gap": 0.5
  }
