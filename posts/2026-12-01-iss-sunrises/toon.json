  "https://www.discovermagazine.com/the-sciences/seeing-16-sunrises-in-24-hours-astronauts-need-different-ways-to-tell-time"
 ],
 "lines": [
  {
   "say": "رُوَّادُ الْفَضَاءِ يَرَوْنَ الشَّمْسَ تُشْرِقُ سِتَّ عَشْرَةَ مَرَّةً كُلَّ يَوْمٍ!",
   "show": "رواد الفضاء يرون الشمس تشرق 16 مرة كل يوم!",
   "gap": 0.3
  },
  {
   "say": "لِأَنَّ مَحَطَّةَ الْفَضَاءِ الدَّوْلِيَّةَ تَدُورُ حَوْلَ الْأَرْضِ مَرَّةً كُلَّ تِسْعِينَ دَقِيقَةً تَقْرِيبًا.",
   "show": "لأن محطة الفضاء الدولية تدور حول الأرض مرة كل 90 دقيقة تقريباً.",
   "gap": 0.6
  },
  {
   "say": "وَفِي كُلِّ دَوْرَةٍ، تَعْبُرُ مِنَ اللَّيْلِ إِلَى النَّهَارِ مَرَّةً!",
   "show": "وفي كل دورة، تعبر من الليل إلى النهار مرة!",
   "gap": 0.4
  },
  {
   "say": "إِذًا، فِي أَرْبَعٍ وَعِشْرِينَ سَاعَةً: سِتَّ عَشْرَةَ دَوْرَةً، وَسِتَّةَ عَشَرَ شُرُوقًا!",
   "show": "إذاً، في 24 ساعة: 16 دورة، و16 شروقاً!",
   "gap": 0.4
  },
  {
   "say": "لِذَلِكَ يَعِيشُ الرُّوَّادُ عَلَى تَوْقِيتِ غْرِينْتِشْ، لَا عَلَى الشَّمْسِ!",
   "show": "لذلك يعيش الرواد على توقيت غرينتش، لا على الشمس!",
   "gap": 0.6
  },
  {
   "say": "أَمَّا نَحْنُ، فَيَكْفِينَا شُرُوقٌ وَاحِدٌ! وَتَابِعْنَا عَلَى كْرِيتِيفْيَا سَايِنْس!",
   "show": "أما نحن، فيكفينا شروق واحد! وتابعنا على كريتيفيا ساينس!",
   "gap": 0.4
  }
 ],
