 "lines": [
  {
   "say": "خُذْ نَفَسًا عَمِيقًا… مَنْ صَنَعَ هَذَا الْأُكْسِجِينَ؟",
   "show": "خذ نفساً عميقاً… من صنع هذا الأكسجين؟"
  },
  {
   "say": "نَحْوُ نِصْفِ أُكْسِجِينِ الْأَرْضِ يَصْنَعُهُ الْبَحْرُ!",
   "show": "نحو نصف أكسجين الأرض يصنعه البحر!"
  },
  {
   "say": "بِفَضْلِ كَائِنَاتٍ صَغِيرَةٍ جِدًّا اسْمُهَا الْعَوَالِقُ النَّبَاتِيَّةُ.",
   "show": "بفضل كائنات صغيرة جداً اسمها العوالق النباتية.",
   "gap": 0.9
  },
  {
   "say": "تَصْنَعُ الْأُكْسِجِينَ بِضَوْءِ الشَّمْسِ، مِثْلَ النَّبَاتَاتِ تَمَامًا.",
   "show": "تصنع الأكسجين بضوء الشمس، مثل النباتات تماماً."
  },
  {
   "say": "وَنَوْعٌ وَاحِدٌ مِنْهَا يَصْنَعُ نَحْوَ خُمْسِ أُكْسِجِينِ الْأَرْضِ!",
   "show": "ونوع واحد منها يصنع نحو خمس أكسجين الأرض!"
  },
  {
   "say": "إِذًا، شُكْرًا لِلْبَحْرِ… وَتَابِعْنَا عَلَى كْرِيتِيفْيَا سَايِنْس!",
   "show": "إذاً، شكراً للبحر… وتابعنا على كريتيفيا ساينس!",
   "gap": 0.5
  }
