 "lines": [
  {
   "say": "تَجَاعِيدُ أَصَابِعِكَ فِي الْمَاءِ لَا يَصْنَعُهَا الْمَاءُ!",
   "show": "تجاعيد أصابعك في الماء لا يصنعها الماء!"
  },
  {
   "say": "ظَنَّ الْعُلَمَاءُ قَدِيمًا أَنَّ الْجِلْدَ يَشْرَبُ الْمَاءَ فَيَنْتَفِخُ.",
   "show": "ظن العلماء قديماً أن الجلد يشرب الماء فينتفخ.",
   "gap": 0.3
  },
  {
   "say": "لَكِنَّ الْحَقِيقَةَ: جِهَازُكَ الْعَصَبِيُّ هُوَ الَّذِي يَصْنَعُهَا!",
   "show": "لكن الحقيقة: جهازك العصبي هو الذي يصنعها!",
   "gap": 0.4
  },
  {
   "say": "فَيُضَيِّقُ الْأَوْعِيَةَ الدَّمَوِيَّةَ تَحْتَ الْجِلْدِ، فَيَنْكَمِشُ طَرَفُ الْإِصْبَعِ وَيَتَجَعَّدُ.",
   "show": "فيضيّق الأوعية الدموية تحت الجلد، فينكمش طرف الإصبع ويتجعد.",
   "gap": 0.8
  },
  {
   "say": "وَالدَّلِيلُ: إِذَا تَضَرَّرَتْ أَعْصَابُ الْإِصْبَعِ، بَقِيَ أَمْلَسَ فِي الْمَاءِ.",
   "show": "والدليل: إذا تضررت أعصاب الإصبع، بقي أملس في الماء.",
   "gap": 0.5
  },
  {
   "say": "وَلَكِنْ لِمَاذَا؟ فِي تَجْرِبَةٍ، نَقَلَتِ الْأَصَابِعُ الْمُجَعَّدَةُ الْكُرَاتِ الْمُبْتَلَّةَ أَسْرَعَ بِنِسْبَةِ اثْنَيْ عَشَرَ بِالْمِئَةِ!",
   "show": "ولكن لماذا؟ في تجربة، نقلت الأصابع المجعدة الكرات المبتلة أسرع بنسبة 12%!",
   "gap": 0.8
  },
  {
   "say": "أَمَّا الْأَشْيَاءُ الْجَافَّةُ، فَلَمْ تُحْدِثِ التَّجَاعِيدُ فَرْقًا.",
   "show": "أما الأشياء الجافة، فلم تحدث التجاعيد فرقاً.",
   "gap": 0.3
  },
  {
   "say": "إِذًا قَدْ تَكُونُ حِيلَةً ذَكِيَّةً لِلْإِمْسَاكِ بِالْمُبْتَلِّ… وَتَابِعْنَا عَلَى كْرِيتِيفْيَا سَايِنْس!",
   "show": "إذاً قد تكون حيلة ذكية للإمساك بالمبتل… وتابعنا على كريتيفيا ساينس!",
   "gap": 0.4
  }
