 "category": "جسم الإنسان",
 "topic": "Brain freeze: why cold ice cream causes a sudden headache",
 "sources": [
  "https://my.clevelandclinic.org/health/diseases/21478-brain-freeze",
  "https://www.sciencedaily.com/releases/2013/05/130522095335.htm",
  "https://www.healthline.com/health/sphenopalatine-ganglioneuralgia-brain-freeze"
 ],
 "lines": [
  {
   "say": "لِمَاذَا يُؤْلِمُكَ رَأْسُكَ حِينَ تَأْكُلُ الْمُثَلَّجَاتِ بِسُرْعَةٍ؟",
   "show": "لماذا يؤلمك رأسك حين تأكل المثلجات بسرعة؟"
  },
  {
   "say": "إِنَّهُ «تَجَمُّدُ الدِّمَاغِ»… لَكِنَّ دِمَاغَكَ لَا يَتَجَمَّدُ أَبَدًا!",
   "show": "إنه «تجمد الدماغ»… لكن دماغك لا يتجمد أبداً!"
  },
  {
   "say": "الْبَرْدُ يَلْمِسُ سَقْفَ فَمِكَ، فَتَتَغَيَّرُ أَوْعِيَةُ الدَّمِ فِي رَأْسِكَ بِسُرْعَةٍ!",
   "show": "البرد يلمس سقف فمك، فتتغير أوعية الدم في رأسك بسرعة!",
   "gap": 0.8
  },
  {
   "say": "تَتَّسِعُ فَجْأَةً لِتُدْفِئَ الْمَكَانَ… فَتَشْعُرُ بِأَلَمٍ حَادٍّ فِي جَبْهَتِكَ!",
   "show": "تتسع فجأة لتدفئ المكان… فتشعر بألم حاد في جبهتك!"
  },
  {
   "say": "وَالْخَبَرُ الْجَيِّدُ: يَزُولُ عَادَةً خِلَالَ ثَوَانٍ إِلَى دَقِيقَتَيْنِ!",
   "show": "والخبر الجيد: يزول عادةً خلال ثوانٍ إلى دقيقتين!",
   "gap": 0.8
  },
  {
   "say": "أَلْصِقْ لِسَانَكَ بِسَقْفِ فَمِكَ، أَوِ اشْرَبْ مَاءً فَاتِرًا…",
   "show": "ألصق لسانك بسقف فمك، أو اشرب ماءً فاتراً…"
  },
  {
   "say": "إِذًا، تَنَاوَلِ الْمُثَلَّجَاتِ بِبُطْءٍ… وَتَابِعْنَا عَلَى كْرِيتِيفْيَا سَايِنْس!",
   "show": "إذاً، تناول المثلجات ببطء… وتابعنا على كريتيفيا ساينس!",
   "gap": 0.5
  }
 ],
