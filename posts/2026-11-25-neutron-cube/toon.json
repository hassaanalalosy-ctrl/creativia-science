 ],
 "lines": [
  {
   "say": "هٰذَا الْمُكَعَّبُ الصَّغِيرُ قَدْ يَزِنُ مِثْلَ جَبَلٍ كَامِلٍ!",
   "show": "هذا المكعب الصغير قد يزن مثل جبل كامل!"
  },
  {
   "say": "لَوْ صُنِعَ مِنْ مَادَّةِ نَجْمٍ نُيُوتْرُونِيٍّ، لَوَزَنَ نَحْوَ مِلْيَارِ طُنٍّ عَلَى الْأَرْضِ!",
   "show": "لو صُنع من مادة نجم نيوتروني، لوزن نحو مليار طن على الأرض!",
   "gap": 0.4
  },
  {
   "say": "فَالنَّجْمُ النُّيُوتْرُونِيُّ بَقَايَا نَجْمٍ ضَخْمٍ انْهَارَ عَلَى نَفْسِهِ.",
   "show": "فالنجم النيوتروني بقايا نجم ضخم انهار على نفسه.",
   "gap": 0.9
  },
  {
   "say": "كُتْلَتُهُ قَدْ تَصِلُ إِلَى ضِعْفِ كُتْلَةِ الشَّمْسِ، فِي كُرَةٍ قُطْرُهَا نَحْوُ عِشْرِينَ كِيلُومِتْرًا فَقَطْ!",
   "show": "كتلته قد تصل إلى ضعف كتلة الشمس، في كرة قطرها نحو 20 كيلومتراً فقط!",
   "gap": 0.4
  },
  {
   "say": "وَأَسْرَعُهَا يَدُورُ أَكْثَرَ مِنْ سَبْعِمِئَةِ مَرَّةٍ فِي الثَّانِيَةِ!",
   "show": "وأسرعها يدور أكثر من 700 مرة في الثانية!",
   "gap": 0.4
  },
  {
   "say": "إِذًا، الْحَجْمُ الصَّغِيرُ لَا يَعْنِي وَزْنًا صَغِيرًا… وَتَابِعْنَا عَلَى كْرِيتِيفْيَا سَايِنْس!",
   "show": "إذاً، الحجم الصغير لا يعني وزناً صغيراً… وتابعنا على كريتيفيا ساينس!",
   "gap": 0.5
  }
 ],
