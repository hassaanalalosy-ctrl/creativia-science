 "category": "حيوانات",
 "topic": "Flamingos are born grey, not pink. Their pink comes from carotenoid pigments in the algae and brine shrimp they eat (the same pigment family that makes carrots orange); they turn pink over their first 2 to 3 years, and zoos add carotenoids such as canthaxanthin to their food so they stay pink.",
 "sources": [
  "https://www.britannica.com/story/why-are-flamingos-pink",
  "https://www.smithsonianmag.com/science-nature/for-some-species-you-really-are-what-you-eat-40747423/",
  "https://blogs.sandiegozoo.org/zoonooz/growing-up-flamingo/",
  "https://lazoo.org/explore-your-zoo/our-animals/birds/flamingos"
 ],
 "lines": [
  {
   "say": "طُيُورُ الْفِلَامِنْغُو تُولَدُ رَمَادِيَّةً، لَا وَرْدِيَّةً!",
   "show": "طيور الفلامنغو تولد رمادية، لا وردية!",
   "gap": 0.6
  },
  {
   "say": "فَمِنْ أَيْنَ يَأْتِي لَوْنُهَا الْوَرْدِيُّ؟ مِنْ طَعَامِهَا!",
   "show": "فمن أين يأتي لونها الوردي؟ من طعامها!",
   "gap": 0.4
  },
  {
   "say": "تَأْكُلُ رُوبْيَانًا صَغِيرًا وَطَحَالِبَ، فِيهَا صِبْغَاتٌ اسْمُهَا الْكَارُوتِينَاتُ.",
   "show": "تأكل روبياناً صغيراً وطحالب، فيها صبغات اسمها الكاروتينات.",
   "gap": 0.9
  },
  {
   "say": "وَهِيَ مِنْ عَائِلَةِ الصِّبْغَةِ الَّتِي تُلَوِّنُ الْجَزَرَ بِالْبُرْتُقَالِيِّ!",
   "show": "وهي من عائلة الصبغة التي تلون الجزر بالبرتقالي!",
   "gap": 0.35
  },
  {
   "say": "وَمَعَ هٰذَا الطَّعَامِ، يَصِيرُ رِيشُهَا وَرْدِيًّا خِلَالَ سَنَتَيْنِ إِلَى ثَلَاثِ سَنَوَاتٍ.",
   "show": "ومع هذا الطعام، يصير ريشها وردياً خلال سنتين إلى 3 سنوات.",
   "gap": 0.9
  },
  {
   "say": "وَلِذٰلِكَ تُضِيفُ حَدَائِقُ الْحَيَوَانِ صِبْغَاتٍ إِلَى طَعَامِهَا لِتَبْقَى وَرْدِيَّةً.",
   "show": "ولذلك تضيف حدائق الحيوان صبغات إلى طعامها لتبقى وردية.",
   "gap": 0.4
  },
  {
   "say": "إِذًا، أَنْتَ مَا تَأْكُلُهُ… حَرْفِيًّا! وَتَابِعْنَا عَلَى كْرِيتِيفْيَا سَايِنْس!",
   "show": "إذاً، أنت ما تأكله… حرفياً! وتابعنا على كريتيفيا ساينس!",
   "gap": 0.5
  }
 ],
