 "category": "فضاء",
 "lines": [
  {
   "say": "هَلْ تَعْلَمُ أَنَّ رُوَّادَ الْفَضَاءِ يَصِيرُونَ أَطْوَلَ فِي الْفَضَاءِ؟",
   "show": "هل تعلم أن رواد الفضاء يصيرون أطول في الفضاء؟"
  },
  {
   "say": "عَلَى الْأَرْضِ، يَحْمِلُ عَمُودُكَ الْفِقْرِيُّ ثِقَلَ جِسْمِكَ طَوَالَ الْوَقْتِ.",
   "show": "على الأرض، يحمل عمودك الفقري ثقل جسمك طوال الوقت."
  },
  {
   "say": "أَمَّا فِي الْفَضَاءِ، فَلَا شَيْءَ يَضْغَطُهُ…",
   "show": "أما في الفضاء، فلا شيء يضغطه…",
   "gap": 0.9
  },
  {
   "say": "فَيَتَمَدَّدُ، وَيَزِيدُ طُولُ الرَّائِدِ نَحْوَ خَمْسَةِ سَنْتِيمِتْرَاتٍ!",
   "show": "فيتمدد، ويزيد طول الرائد نحو 5 سنتيمترات!"
  },
  {
   "say": "لَكِنْ حِينَ يَعُودُ إِلَى الْأَرْضِ… يَرْجِعُ إِلَى طُولِهِ الْمُعْتَادِ!",
   "show": "لكن حين يعود إلى الأرض… يرجع إلى طوله المعتاد!",
   "gap": 0.9
  },
  {
   "say": "إِذًا، الْفَضَاءُ يَمْنَحُكَ بِضْعَةَ سَنْتِيمِتْرَاتٍ مُؤَقَّتًا… وَتَابِعْنَا عَلَى كْرِيتِيفْيَا سَايِنْس!",
   "show": "إذاً، الفضاء يمنحك بضعة سنتيمترات مؤقتاً… وتابعنا على كريتيفيا ساينس!",
   "gap": 0.5
  }
 ],
