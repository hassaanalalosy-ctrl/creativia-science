 "voiceId": "JjTirzdD7T3GMLkwdd3a",
 "category": "كيمياء الحياة اليومية",
 "lines": [
  {
   "say": "لِمَاذَا يُبْكِيكَ الْبَصَلُ؟",
   "show": "لماذا يبكيك البصل؟"
  },
  {
   "say": "حِينَ تَقْطَعُهُ، تَنْكَسِرُ خَلَايَاهُ الصَّغِيرَةُ.",
   "show": "حين تقطعه، تنكسر خلاياه الصغيرة."
  },
  {
   "say": "فَتَخْتَلِطُ مَوَادُّهَا وَتَصْنَعُ غَازًا يَطِيرُ فِي الْهَوَاءِ.",
   "show": "فتختلط موادها وتصنع غازاً يطير في الهواء.",
   "gap": 0.9
  },
  {
   "say": "يَصِلُ الْغَازُ إِلَى عَيْنَيْكَ فَيُهَيِّجُهُمَا.",
   "show": "يصل الغاز إلى عينيك فيهيجهما."
  },
  {
   "say": "فَتُفْرِزُ عَيْنَاكَ الدُّمُوعَ لِتَغْسِلَهُ بَعِيدًا!",
   "show": "فتفرز عيناك الدموع لتغسله بعيداً!"
  },
  {
   "say": "نَصِيحَةٌ: بَرِّدِ الْبَصَلَ قَبْلَ تَقْطِيعِهِ، فَيَخْرُجُ غَازٌ أَقَلُّ.",
   "show": "نصيحة: برّد البصل قبل تقطيعه، فيخرج غاز أقل.",
   "gap": 0.9
  },
  {
   "say": "إِذًا، الْبَصَلُ لَا يُحْزِنُكَ… وَتَابِعْنَا عَلَى كْرِيتِيفْيَا سَايِنْس!",
   "show": "إذاً، البصل لا يحزنك… وتابعنا على كريتيفيا ساينس!",
   "gap": 0.5
  }
 ],
