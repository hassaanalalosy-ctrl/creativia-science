 "category": "جسم الإنسان",
 "topic": "Your bone marrow makes about 2 million red blood cells every second (about 120 million a minute); each lives about 120 days carrying oxygen, then is removed in the spleen and liver and its iron is reused.",
 "sources": [
  "https://stanfordbloodcenter.org/how_long_do_red/",
  "https://stanfordbloodcenter.org/red_blood_cells-2/",
  "https://www.britannica.com/science/blood-biochemistry/Production-of-red-blood-cells-erythropoiesis",
  "https://openstax.org/books/anatomy-and-physiology/pages/18-3-erythrocytes",
  "https://medlineplus.gov/ency/anatomyvideos/000104.htm"
 ],
 "lines": [
  {
   "say": "كُلَّ ثَانِيَةٍ، يَصْنَعُ جِسْمُكَ نَحْوَ مِلْيُونَيْ كُرَيَّةِ دَمٍ حَمْرَاءَ!",
   "show": "كل ثانية، يصنع جسمك نحو مليوني كرية دم حمراء!",
   "gap": 0.4
  },
  {
   "say": "يَصْنَعُهَا نُخَاعُ الْعَظْمِ، مَصْنَعٌ صَغِيرٌ دَاخِلَ عِظَامِكَ.",
   "show": "يصنعها نخاع العظم، مصنع صغير داخل عظامك.",
   "gap": 0.6
  },
  {
   "say": "ثُمَّ تُسَافِرُ كُلُّ كُرَيَّةٍ فِي دَمِكَ نَحْوَ مِئَةٍ وَعِشْرِينَ يَوْمًا.",
   "show": "ثم تسافر كل كرية في دمك نحو 120 يوماً.",
   "gap": 0.6
  },
  {
   "say": "تَحْمِلُ الْأُكْسُجِينَ إِلَى كُلِّ خَلِيَّةٍ فِي جِسْمِكَ.",
   "show": "تحمل الأكسجين إلى كل خلية في جسمك.",
   "gap": 0.4
  },
  {
   "say": "وَحِينَ تَشِيخُ، يُفَكِّكُهَا الطِّحَالُ وَالْكَبِدُ، وَيُعَادُ اسْتِخْدَامُ حَدِيدِهَا!",
   "show": "وحين تشيخ، يفككها الطحال والكبد، ويعاد استخدام حديدها!",
   "gap": 0.4
  },
  {
   "say": "إِذًا، فِي دَقِيقَةٍ وَاحِدَةٍ يَصْنَعُ جِسْمُكَ نَحْوَ مِئَةٍ وَعِشْرِينَ مِلْيُونًا مِنْهَا!",
   "show": "إذاً، في دقيقة واحدة يصنع جسمك نحو 120 مليوناً منها!",
   "gap": 0.6
  },
  {
   "say": "جِسْمُكَ مَصْنَعٌ لَا يَتَوَقَّفُ! وَتَابِعْنَا عَلَى كْرِيتِيفْيَا سَايِنْس!",
   "show": "جسمك مصنع لا يتوقف! وتابعنا على كريتيفيا ساينس!",
   "gap": 0.4
  }
 ],
