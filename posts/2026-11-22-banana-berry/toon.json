{
 "engine": 4,
 "voice": true,
 "voiceId": "JjTirzdD7T3GMLkwdd3a",
 "category": "نباتات",
 "topic": "Botanically, a banana is a berry (one flower, one ovary, seeds inside the flesh) but a strawberry is not: it grows from a flower with many ovaries and its yellow 'seeds' are tiny fruits (achenes), each holding one seed",
 "sources": [
  "https://www.livescience.com/57477-why-are-bananas-considered-berries.html",
  "https://sciencenotes.org/is-a-strawberry-a-berry-why-the-answer-is-surprisingly-no/"
 ],
 "lines": [
  {
   "say": "الْمَوْزُ مِنَ التُّوتِيَّاتِ… وَالْفَرَاوْلَةُ لَيْسَتْ مِنْهَا!",
   "show": "الموز من التوتيات… والفراولة ليست منها!"
  },
  {
   "say": "عِنْدَ عُلَمَاءِ النَّبَاتِ، الثَّمَرَةُ التُّوتِيَّةُ تَنْمُو مِنْ زَهْرَةٍ وَاحِدَةٍ بِمِبْيَضٍ وَاحِدٍ.",
   "show": "عند علماء النبات، الثمرة التوتية تنمو من زهرة واحدة بمبيض واحد."
  },
  {
   "say": "وَبُذُورُهَا مُخْتَبِئَةٌ دَاخِلَ لُبِّهَا… مِثْلَ الْمَوْزِ وَالْعِنَبِ وَالطَّمَاطِمِ!",
   "show": "وبذورها مختبئة داخل لبها… مثل الموز والعنب والطماطم!"
  },
  {
   "say": "أَمَّا الْفَرَاوْلَةُ فَتَنْمُو مِنْ زَهْرَةٍ فِيهَا مَبَايِضُ كَثِيرَةٌ.",
   "show": "أما الفراولة فتنمو من زهرة فيها مبايض كثيرة.",
   "gap": 0.9
  },
  {
   "say": "وَتِلْكَ الْحُبُوبُ الصَّفْرَاءُ عَلَى سَطْحِهَا لَيْسَتْ بُذُورًا… بَلْ هِيَ ثِمَارٌ صَغِيرَةٌ، فِي كُلٍّ مِنْهَا بِذْرَةٌ!",
   "show": "وتلك الحبوب الصفراء على سطحها ليست بذوراً… بل هي ثمار صغيرة، في كل منها بذرة!"
  },
  {
   "say": "إِذًا، الْمَوْزُ مِنَ التُّوتِيَّاتِ وَالْفَرَاوْلَةُ لَا… وَتَابِعْنَا عَلَى كْرِيتِيفْيَا سَايِنْس!",
   "show": "إذاً، الموز من التوتيات والفراولة لا… وتابعنا على كريتيفيا ساينس!",
   "gap": 0.5
  }
 ],
