 "lines": [
  {
   "say": "لِمَاذَا السَّمَاءُ زَرْقَاءُ، مَعَ أَنَّ ضَوْءَ الشَّمْسِ أَبْيَضُ؟",
   "show": "لماذا السماء زرقاء، مع أن ضوء الشمس أبيض؟"
  },
  {
   "say": "لِأَنَّ ضَوْءَ الشَّمْسِ يَحْمِلُ كُلَّ الْأَلْوَانِ مَعًا!",
   "show": "لأن ضوء الشمس يحمل كل الألوان معاً!"
  },
  {
   "say": "وَحِينَ يَمُرُّ فِي الْهَوَاءِ، يَتَبَعْثَرُ الْأَزْرَقُ أَكْثَرَ مِنَ الْأَحْمَرِ بِكَثِيرٍ.",
   "show": "وحين يمر في الهواء، يتبعثر الأزرق أكثر من الأحمر بكثير."
  },
  {
   "say": "فَيَصِلُنَا الْأَزْرَقُ مِنْ كُلِّ أَنْحَاءِ السَّمَاءِ!",
   "show": "فيصلنا الأزرق من كل أنحاء السماء!"
  },
  {
   "say": "أَمَّا فَوْقَ الْهَوَاءِ… فَالسَّمَاءُ سَوْدَاءُ حَتَّى فِي النَّهَارِ!",
   "show": "أما فوق الهواء… فالسماء سوداء حتى في النهار!",
   "gap": 0.9
  },
  {
   "say": "إِذًا، الْهَوَاءُ هُوَ سِرُّ الْأَزْرَقِ… وَتَابِعْنَا عَلَى كْرِيتِيفْيَا سَايِنْس!",
   "show": "إذاً، الهواء هو سر الأزرق… وتابعنا على كريتيفيا ساينس!",
   "gap": 0.5
  }
 ],
