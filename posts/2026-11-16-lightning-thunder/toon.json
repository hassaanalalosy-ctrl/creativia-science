{
 "engine": 4,
 "voice": true,
 "voiceId": "JjTirzdD7T3GMLkwdd3a",
 "category": "الأرض والطقس",
 "lines": [
  {
   "say": "لِمَاذَا نَرَى الْبَرْقَ قَبْلَ أَنْ نَسْمَعَ الرَّعْدَ؟",
   "show": "لماذا نرى البرق قبل أن نسمع الرعد؟"
  },
  {
   "say": "الْبَرْقُ وَالرَّعْدُ يَحْدُثَانِ فِي اللَّحْظَةِ نَفْسِهَا!",
   "show": "البرق والرعد يحدثان في اللحظة نفسها!"
  },
  {
   "say": "لَكِنَّ الضَّوْءَ يَقْطَعُ نَحْوَ ثَلَاثِمِئَةِ أَلْفِ كِيلُومِتْرٍ فِي الثَّانِيَةِ!",
   "show": "لكن الضوء يقطع نحو 300 ألف كيلومتر في الثانية!",
   "gap": 0.8
  },
  {
   "say": "أَمَّا الصَّوْتُ، فَيَقْطَعُ نَحْوَ ثَلَاثِمِئَةٍ وَأَرْبَعِينَ مِتْرًا فَقَطْ فِي الثَّانِيَةِ!",
   "show": "أما الصوت، فيقطع نحو 340 متراً فقط في الثانية!"
  },
  {
   "say": "عُدَّ الثَّوَانِيَ بَيْنَ الْبَرْقِ وَالرَّعْدِ، وَاقْسِمْهَا عَلَى ثَلَاثَةٍ…",
   "show": "عد الثواني بين البرق والرعد، واقسمها على 3…",
   "gap": 0.8
  },
  {
   "say": "فَتَعْرِفَ بُعْدَ الْعَاصِفَةِ عَنْكَ بِالْكِيلُومِتْرَاتِ تَقْرِيبًا!",
   "show": "فتعرف بعد العاصفة عنك بالكيلومترات تقريباً!"
  },
  {
   "say": "إِذًا، إِنْ سَمِعْتَ الرَّعْدَ فَادْخُلْ إِلَى مَكَانٍ آمِنٍ… وَتَابِعْنَا عَلَى كْرِيتِيفْيَا سَايِنْس!",
   "show": "إذاً، إن سمعت الرعد فادخل إلى مكان آمن… وتابعنا على كريتيفيا ساينس!",
   "gap": 0.5
  }
 ],
