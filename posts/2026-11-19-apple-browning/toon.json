 "voiceId": "JjTirzdD7T3GMLkwdd3a",
 "category": "كيمياء الحياة اليومية",
 "lines": [
  {
   "say": "لِمَاذَا يَصِيرُ التُّفَّاحُ الْمَقْطُوعُ بُنِّيًّا؟",
   "show": "لماذا يصير التفاح المقطوع بنياً؟"
  },
  {
   "say": "حِينَ تَقْطَعُهُ، تَنْكَسِرُ خَلَايَاهُ وَيَدْخُلُهَا الْهَوَاءُ.",
   "show": "حين تقطعه، تنكسر خلاياه ويدخلها الهواء."
  },
  {
   "say": "فَيَلْتَقِي أُكْسِجِينُ الْهَوَاءِ بِإِنْزِيمٍ فِي التُّفَّاحَةِ.",
   "show": "فيلتقي أكسجين الهواء بإنزيم في التفاحة.",
   "gap": 0.9
  },
  {
   "say": "فَيُحَوِّلَانِ مَوَادَّ التُّفَّاحَةِ إِلَى صِبْغَةٍ بُنِّيَّةٍ!",
   "show": "فيحوّلان مواد التفاحة إلى صبغة بنية!"
  },
  {
   "say": "لَكِنَّ عَصِيرَ اللَّيْمُونِ يُبْطِئُ هَذَا التَّفَاعُلَ.",
   "show": "لكن عصير الليمون يبطئ هذا التفاعل.",
   "gap": 0.9
  },
  {
   "say": "فَحُمُوضَتُهُ تُضْعِفُ عَمَلَ الْإِنْزِيمِ.",
   "show": "فحموضته تضعف عمل الإنزيم."
  },
  {
   "say": "إِذًا، التُّفَّاحَةُ لَا تَصْدَأُ… وَتَابِعْنَا عَلَى كْرِيتِيفْيَا سَايِنْس!",
   "show": "إذاً، التفاحة لا تصدأ… وتابعنا على كريتيفيا ساينس!",
   "gap": 0.5
  }
 ],
